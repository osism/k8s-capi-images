#!/bin/bash
# Runs in the chroot. Drives image-builder's roles through wrapper.yml with the
# build shims on PATH and a policy-rc.d in place, so daemon-touching tasks
# succeed in the systemd-less chroot while still writing their config files.

if [ "${DIB_DEBUG_TRACE:-0}" -gt 0 ]; then
    set -x
fi
set -euo pipefail

STAGE=/tmp/in_target.d/image-builder
VENV=/opt/image-builder-venv

# Stop apt from starting services while packages are installed in the chroot.
cat > /usr/sbin/policy-rc.d <<'EOF'
#!/bin/sh
exit 101
EOF
chmod 0755 /usr/sbin/policy-rc.d

# ansible-core 2.18 aborts at startup unless the locale encoding is UTF-8, and a
# fresh chroot has no locale set ("Detected None"). C.UTF-8 is built into glibc
# on Noble, so no locale needs to be generated first.
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

export ANSIBLE_CONFIG="${STAGE}/ansible.cfg"
export PATH="${STAGE}/shims:${VENV}/bin:${PATH}"

# community.general.modprobe decides whether a module is already loaded by
# reading /proc/modules and then /lib/modules/$(uname -r)/modules.builtin, in
# Python -- the modprobe shim never sees that lookup. Both paths are wrong in a
# chroot: /proc belongs to the build host, while /lib/modules holds the modules
# of the *image's* kernel. The lookup therefore only finds a modules.builtin
# when the build host kernel happens to have the same version as the image's,
# which is what kept it working while a Noble host built Noble images. A Noble
# host building a Resolute image has no such directory, and the node role's
# "Ensure overlay module is present" task dies with FileNotFoundError.
#
# Stage an empty modules.builtin for the running kernel so the lookup finds no
# built-in module and the module falls through to calling modprobe, which is
# this element's no-op shim -- exactly the path taken on a matching host. Either
# way nothing is loaded and nothing needs to be: the module is only asked for
# state=present (persistent defaults to "disabled"), and the image gets its
# modules from /etc/modules-load.d/kubernetes.conf, which the same role writes
# from a separate copy task.
#
# Only a missing file is stubbed, never an existing one, and the stub is removed
# again on exit so it cannot ship in the image. That distinction matters: on a
# matching host the directory is the image's real one, full of its real modules.
MODULES_DIR="/lib/modules/$(uname -r)"
MODULES_BUILTIN="${MODULES_DIR}/modules.builtin"
STUB_FILE=""
STUB_DIR=""

remove_modules_builtin_stub() {
    if [ -n "${STUB_FILE}" ]; then
        rm -f "${STUB_FILE}"
    fi
    # Only ever removes the directory this script created, and only while it is
    # empty, so a real /lib/modules/<version> is never touched.
    if [ -n "${STUB_DIR}" ]; then
        rmdir "${STUB_DIR}" 2>/dev/null || true
    fi
    return 0
}

if [ ! -e "${MODULES_BUILTIN}" ]; then
    if [ ! -d "${MODULES_DIR}" ]; then
        STUB_DIR="${MODULES_DIR}"
    fi
    STUB_FILE="${MODULES_BUILTIN}"
    trap remove_modules_builtin_stub EXIT
    mkdir -p "${MODULES_DIR}"
    : > "${MODULES_BUILTIN}"
fi

cd "${STAGE}"

# The override is loaded last so its Kubernetes/containerd/runc versions win.
# containerd_service_url, packer_builder_type and packer_build_name are the
# Packer user-vars the roles need that are not in the config files. python_path
# is intentionally not passed: wrapper.yml omits PYTHONPATH via default(omit),
# because an empty value would add the staging dir to root's sys.path.
#
# temp_files is forced empty so image-builder's sysprep "Reset temp space" task
# deletes nothing. That task wipes everything at depth 1 under /tmp, which in the
# chroot includes DIB's read-only /tmp/in_target.d bind mount (the very tree we
# run from); deleting it fails with EROFS. Extra vars outrank the value the task
# registers from its find, so the reset loop runs over an empty list. The wipe is
# not reproduced elsewhere: during DIB's chroot phases /tmp holds DIB's own
# machinery (the in_target.d mount, dib-run-parts' profile dir), the leftover
# build temp is tiny, and /tmp is cleared on boot.
#
# kubeadm_template replaces the kubeadm config the kubernetes role renders for
# the offline image pre-pull: the template shipped at the pinned ref declares
# kubeadm.k8s.io/v1beta3, which kubeadm 1.37 removed. It is passed as an
# absolute path so it resolves outside the role's own templates/ directory.
#
# ansible_python_interpreter is pinned to the venv interpreter because
# ansible-core 2.18's interpreter discovery only probes python3.13 and older
# before falling back to /usr/bin/python3. On Noble (python3.12) that lookup
# happened to hit the venv's python3.12 on PATH, so python-debian was found; on
# Resolute (python3.14) it silently lands on the system interpreter and
# deb822_repository fails with "No module named 'debian'". The apt family still
# respawns itself under /usr/bin/python3 to reach python3-apt.
#
# image-builder has no Debian build target (kubernetes-sigs/image-builder#2019),
# and two node role defaults are Ubuntu-only. On Debian both are overridden in
# one extra-var object; on Ubuntu the array stays empty and the invocation is
# unchanged. Extra vars are safe here because only the intended places read
# these names: the node role's meta dependency on setup reads common_virt_debs,
# and the node role reads sysctl_conf_file.
#
#   * common_virt_debs names Ubuntu's linux-cloud-tools-virtual and
#     linux-tools-virtual metapackages, which Debian 13 does not have, so the
#     setup role fails with "No package matching 'linux-cloud-tools-virtual' is
#     available". hyperv-daemons and linux-perf are Debian's packages for the
#     same Hyper-V daemons and perf tools. hyperv-daemons is required: the
#     providers role's openstack tasks disable hv-kvp-daemon, and on Debian only
#     that package ships the unit. Drop the key once the node defaults name
#     Debian packages for common_virt_debs and the pin moves past that change.
#   * sysctl_conf_file resolves to /etc/sysctl.conf on Debian. systemd 257 on
#     Debian 13 never reads that file, so the image would boot without
#     net.ipv4.ip_forward=1 and the bridge-netfilter settings. Drop the key once
#     the node defaults resolve sysctl_conf_file to /etc/sysctl.d/99-sysctl.conf
#     on Debian and the pin moves past that change.
DISTRO_EXTRA_VARS=()
if [ "${DISTRO_NAME:-}" = debian ]; then
    DISTRO_EXTRA_VARS=(-e '{"common_virt_debs": ["hyperv-daemons", "linux-perf", "open-vm-tools"], "sysctl_conf_file": "/etc/sysctl.d/99-sysctl.conf"}')
fi

ansible-playbook -i 'localhost,' -c local ansible/wrapper.yml \
    -e ansible_python_interpreter="${VENV}/bin/python3" \
    -e @config/common.json \
    -e @config/containerd.json \
    -e @config/cni.json \
    -e @config/kubernetes.json \
    -e @config/wasm-shims.json \
    -e @config/additional_components.json \
    -e @config/ecr_credential_provider.json \
    -e @override.json \
    -e '{"temp_files": {"files": []}}' \
    -e kubeadm_template="${STAGE}/kubeadm.yml.j2" \
    -e packer_builder_type=openstack \
    -e packer_build_name=openstack \
    -e 'containerd_service_url=https://raw.githubusercontent.com/containerd/containerd/refs/tags/v{{ containerd_version }}/containerd.service' \
    "${DISTRO_EXTRA_VARS[@]}"

# image-builder's containerd role downloads containerd.service over HTTPS with no
# checksum and installs it as the root-run containerd unit on every node. Gate the
# shipped unit against the known-good upstream hashes so a tampered or moved tag
# cannot inject an arbitrary systemd unit into the image. Extend the allowlist
# when the pinned containerd version changes.
unit=/etc/systemd/system/containerd.service
actual="$(sha256sum "${unit}" | awk '{print $1}')"
case "${actual}" in
    # containerd 2.2.2 and 2.3.2 (image-builder default) -- upstream ships a
    # byte-identical unit for both, so one entry covers them
    1941362cbaa89dd591b99c32b050d82c583d3cd2e5fa63085d7017457ec5fca8) ;;
    *)
        echo "ERROR: ${unit} sha256 ${actual} is not in the pinned allowlist" >&2
        exit 1
        ;;
esac
